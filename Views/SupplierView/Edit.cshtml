@model Erp.Models.Supplier
@{
    ViewData["Title"] = "Edit supplier";
    ViewData["Section"] = "Operations";
    ViewData["ActiveNav"] = "Suppliers";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="mb-6">
    <a href="/suppliers" class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-slate-700">
    @await Html.PartialAsync("_Icon", "back|h-4 w-4")
    Suppliers
</a>
    <h2 class="mt-2 text-lg font-semibold text-slate-900">Edit Supplier</h2>
    <p class="mt-1 text-sm text-slate-500">Contact details for a vendor.</p>
</div>

<div class="max-w-4xl rounded-xl border border-slate-200 bg-white p-6">
    <form method="post" action="/suppliers/edit/@Model.supplier_id" class="space-y-6">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="supplier_id" />
<div class="grid grid-cols-1 gap-x-6 gap-y-5 sm:grid-cols-6">
<div class="sm:col-span-6">
<label asp-for="name_of_supplier" class="mb-1.5 block text-sm font-medium text-slate-700">Supplier name</label>
<input asp-for="name_of_supplier" type="text" required maxlength="100"
       class="block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500" />
<span asp-validation-for="name_of_supplier" class="mt-1 block text-xs text-rose-600"></span>
</div>
<div class="sm:col-span-3">
<label asp-for="contact_person" class="mb-1.5 block text-sm font-medium text-slate-700">Contact person</label>
<input asp-for="contact_person" type="text"
       class="block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500" />
<span asp-validation-for="contact_person" class="mt-1 block text-xs text-rose-600"></span>
</div>
<div class="sm:col-span-3">
<label asp-for="email" class="mb-1.5 block text-sm font-medium text-slate-700">Email</label>
<input asp-for="email" type="email" maxlength="100"
       class="block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500" />
<span asp-validation-for="email" class="mt-1 block text-xs text-rose-600"></span>
</div>
<div class="sm:col-span-3">
<label asp-for="phone" class="mb-1.5 block text-sm font-medium text-slate-700">Phone</label>
<input asp-for="phone" type="text" maxlength="20"
       class="block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500" />
<span asp-validation-for="phone" class="mt-1 block text-xs text-rose-600"></span>
</div>
<div class="sm:col-span-6">
<label asp-for="address" class="mb-1.5 block text-sm font-medium text-slate-700">Address</label>
<textarea asp-for="address" rows="2" placeholder=""
          class="block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500"></textarea>
<span asp-validation-for="address" class="mt-1 block text-xs text-rose-600"></span>
</div>
        </div>

        <div class="flex items-center gap-3 border-t border-slate-100 pt-5">
            <button type="submit" class="rounded-lg bg-teal-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-teal-700">Save changes</button>
            <a href="/suppliers" class="rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
