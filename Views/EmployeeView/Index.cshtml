@model IEnumerable<Erp.Models.Employee>
@{
    ViewData["Title"] = "Employees";
    ViewData["Section"] = "Human resources";
    ViewData["ActiveNav"] = "Employees";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <div>
        <h2 class="text-lg font-semibold text-slate-900">Employees</h2>
        <p class="mt-1 text-sm text-slate-500">Your team directory, roles, and employment status.</p>
    </div>
    <a href="/employees/create" class="inline-flex items-center gap-2 rounded-lg bg-teal-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-teal-700">
        @await Html.PartialAsync("_Icon", "plus|h-4 w-4")
        Add employee
    </a>
</div>

<div class="rounded-xl border border-slate-200 bg-white">
    <div class="border-b border-slate-200 p-4">
        <div class="relative max-w-xs">
            <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                @await Html.PartialAsync("_Icon", "search|h-4 w-4")
            </span>
            <input type="text" data-table-search="#employees-table" placeholder="Search employees"
                   class="block w-full rounded-lg border border-slate-300 py-2 pl-9 pr-3 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500" />
        </div>
    </div>

    <div class="overflow-x-auto">
        <table id="employees-table" class="w-full text-left text-sm">
            <thead>
                <tr class="border-b border-slate-200 text-xs font-medium text-slate-500">
                    <th class="px-4 py-3">Employee</th>
                    <th class="px-4 py-3">Job title</th>
                    <th class="px-4 py-3">Department</th>
                    <th class="px-4 py-3">Status</th>
                    <th class="px-4 py-3">Hire date</th>
                    <th class="px-4 py-3 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr class="hover:bg-slate-50">
                            <td class="px-4 py-3"><div class="flex items-center gap-3"><span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-slate-100 text-xs font-semibold text-slate-600">@(item.first_name.Length > 0 ? item.first_name.Substring(0, 1).ToUpper() : "?")</span><div><p class="font-medium text-slate-800">@item.first_name @item.last_name</p><p class="text-xs text-slate-400">@item.email</p></div></div></td>
                            <td class="px-4 py-3">@(string.IsNullOrEmpty(item.job_title) ? "—" : item.job_title)</td>
                            <td class="px-4 py-3">@(string.IsNullOrEmpty(item.department) ? "—" : item.department)</td>
                            <td class="px-4 py-3">@await Html.PartialAsync("_StatusBadge", item.status)</td>
                            <td class="px-4 py-3">@item.hire_date.ToString("MMM d, yyyy")</td>
                            <td class="px-4 py-3">
                                <div class="flex items-center justify-end gap-1">
                                    <a href="/employees/details/@item.employee_id" title="View" class="rounded-lg p-2 text-slate-400 hover:bg-slate-100 hover:text-slate-700">@await Html.PartialAsync("_Icon", "eye|h-4 w-4")</a>
                                    <a href="/employees/edit/@item.employee_id" title="Edit" class="rounded-lg p-2 text-slate-400 hover:bg-slate-100 hover:text-slate-700">@await Html.PartialAsync("_Icon", "pencil|h-4 w-4")</a>
                                    <a href="/employees/delete/@item.employee_id" title="Delete" class="rounded-lg p-2 text-slate-400 hover:bg-rose-50 hover:text-rose-600">@await Html.PartialAsync("_Icon", "trash|h-4 w-4")</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                <tr data-empty-row class="hidden">
                    <td colspan="6" class="px-4 py-10 text-center text-sm text-slate-400">No employees match your search.</td>
                </tr>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="6" class="px-4 py-10 text-center text-sm text-slate-400">
                            No employees yet. <a href="/employees/create" class="font-medium text-teal-600 hover:text-teal-700">Add the first one</a>.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
