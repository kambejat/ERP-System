@model Erp.Models.Setting
@{
    ViewData["Title"] = "Edit setting";
    ViewData["Section"] = "Administration";
    ViewData["ActiveNav"] = "Settings";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="mb-6">
    <a href="/settings" class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-slate-700">
        @await Html.PartialAsync("_Icon", "back|h-4 w-4")
        Settings
    </a>
    <h2 class="mt-2 text-lg font-semibold text-slate-900">Edit @Model.setting_key</h2>
</div>

<div class="max-w-xl rounded-xl border border-slate-200 bg-white p-6">
    <form method="post" action="/settings/edit/@Uri.EscapeDataString(Model.setting_key)" class="space-y-5">
        @Html.AntiForgeryToken()
        <div>
            <label asp-for="setting_key" class="mb-1.5 block text-sm font-medium text-slate-700">Key</label>
            <input asp-for="setting_key" type="text" readonly
                   class="block w-full cursor-not-allowed rounded-lg border border-slate-200 bg-slate-50 px-3 py-2.5 font-mono text-sm text-slate-500" />
        </div>
        <div>
            <label asp-for="setting_value" class="mb-1.5 block text-sm font-medium text-slate-700">Value</label>
            <textarea asp-for="setting_value" rows="4" required
                      class="block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500"></textarea>
            <span asp-validation-for="setting_value" class="mt-1 block text-xs text-rose-600"></span>
        </div>
        <div class="flex items-center gap-3 border-t border-slate-100 pt-5">
            <button type="submit" class="rounded-lg bg-teal-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-teal-700">Save changes</button>
            <a href="/settings" class="rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
