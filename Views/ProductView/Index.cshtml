@model IEnumerable<Erp.Models.Product>
@{
    ViewData["Title"] = "Products";
    ViewData["Section"] = "Operations";
    ViewData["ActiveNav"] = "Products";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <div>
        <h2 class="text-lg font-semibold text-slate-900">Products</h2>
        <p class="mt-1 text-sm text-slate-500">Catalog, pricing, and stock levels.</p>
    </div>
    <a href="/products/create" class="inline-flex items-center gap-2 rounded-lg bg-teal-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-teal-700">
        @await Html.PartialAsync("_Icon", "plus|h-4 w-4")
        Add product
    </a>
</div>

<div class="rounded-xl border border-slate-200 bg-white">
    <div class="border-b border-slate-200 p-4">
        <div class="relative max-w-xs">
            <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                @await Html.PartialAsync("_Icon", "search|h-4 w-4")
            </span>
            <input type="text" data-table-search="#products-table" placeholder="Search products"
                   class="block w-full rounded-lg border border-slate-300 py-2 pl-9 pr-3 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500" />
        </div>
    </div>

    <div class="overflow-x-auto">
        <table id="products-table" class="w-full text-left text-sm">
            <thead>
                <tr class="border-b border-slate-200 text-xs font-medium text-slate-500">
                    <th class="px-4 py-3">Product</th>
                    <th class="px-4 py-3">Category</th>
                    <th class="px-4 py-3">Price</th>
                    <th class="px-4 py-3">Stock</th>
                    <th class="px-4 py-3 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr class="hover:bg-slate-50">
                            <td class="px-4 py-3"><div><p class="font-medium text-slate-800">@item.name_of_product</p><p class="font-mono text-xs text-slate-400">@(string.IsNullOrEmpty(item.sku) ? "No SKU" : item.sku)</p></div></td>
                            <td class="px-4 py-3">@(string.IsNullOrEmpty(item.category) ? "—" : item.category)</td>
                            <td class="px-4 py-3">@("$" + (item.price).ToString("N2"))</td>
                            <td class="px-4 py-3"><div class="flex items-center gap-2"><span class="font-mono">@item.quantity_in_stock</span>@if (item.quantity_in_stock <= item.reorder_level){ <span class="inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700 ring-1 ring-inset ring-amber-200">Low</span> }</div></td>
                            <td class="px-4 py-3">
                                <div class="flex items-center justify-end gap-1">
                                    <a href="/products/details/@item.product_id" title="View" class="rounded-lg p-2 text-slate-400 hover:bg-slate-100 hover:text-slate-700">@await Html.PartialAsync("_Icon", "eye|h-4 w-4")</a>
                                    <a href="/products/edit/@item.product_id" title="Edit" class="rounded-lg p-2 text-slate-400 hover:bg-slate-100 hover:text-slate-700">@await Html.PartialAsync("_Icon", "pencil|h-4 w-4")</a>
                                    <a href="/products/delete/@item.product_id" title="Delete" class="rounded-lg p-2 text-slate-400 hover:bg-rose-50 hover:text-rose-600">@await Html.PartialAsync("_Icon", "trash|h-4 w-4")</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                <tr data-empty-row class="hidden">
                    <td colspan="5" class="px-4 py-10 text-center text-sm text-slate-400">No products match your search.</td>
                </tr>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="5" class="px-4 py-10 text-center text-sm text-slate-400">
                            No products yet. <a href="/products/create" class="font-medium text-teal-600 hover:text-teal-700">Add the first one</a>.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
