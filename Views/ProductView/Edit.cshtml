@model Erp.Models.Product
@{
    ViewData["Title"] = "Edit product";
    ViewData["Section"] = "Operations";
    ViewData["ActiveNav"] = "Products";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="mb-6">
    <a href="/products" class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-slate-700">
    @await Html.PartialAsync("_Icon", "back|h-4 w-4")
    Products
</a>
    <h2 class="mt-2 text-lg font-semibold text-slate-900">Edit Product</h2>
    <p class="mt-1 text-sm text-slate-500">Details shown in the catalog and used on order line items.</p>
</div>

<div class="max-w-4xl rounded-xl border border-slate-200 bg-white p-6">
    <form method="post" action="/products/edit/@Model.product_id" class="space-y-6">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="product_id" />
<div class="grid grid-cols-1 gap-x-6 gap-y-5 sm:grid-cols-6">
<div class="sm:col-span-6">
<label asp-for="name_of_product" class="mb-1.5 block text-sm font-medium text-slate-700">Product name</label>
<input asp-for="name_of_product" type="text" required maxlength="100"
       class="block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500" />
<span asp-validation-for="name_of_product" class="mt-1 block text-xs text-rose-600"></span>
</div>
<div class="sm:col-span-3">
<label asp-for="sku" class="mb-1.5 block text-sm font-medium text-slate-700">SKU</label>
<input asp-for="sku" type="text" maxlength="50"
       class="block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500" />
<span asp-validation-for="sku" class="mt-1 block text-xs text-rose-600"></span>
</div>
<div class="sm:col-span-3">
<label asp-for="category" class="mb-1.5 block text-sm font-medium text-slate-700">Category</label>
<input asp-for="category" type="text" maxlength="50"
       class="block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500" />
<span asp-validation-for="category" class="mt-1 block text-xs text-rose-600"></span>
</div>
<div class="sm:col-span-6">
<label asp-for="description" class="mb-1.5 block text-sm font-medium text-slate-700">Description</label>
<textarea asp-for="description" rows="3" placeholder=""
          class="block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500"></textarea>
<span asp-validation-for="description" class="mt-1 block text-xs text-rose-600"></span>
</div>
<div class="sm:col-span-3">
<label asp-for="price" class="mb-1.5 block text-sm font-medium text-slate-700">Price</label>
<input asp-for="price" type="number" required step="0.01" min="0"
       class="block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500" />
<span asp-validation-for="price" class="mt-1 block text-xs text-rose-600"></span>
</div>
<div class="sm:col-span-3">
<label asp-for="quantity_in_stock" class="mb-1.5 block text-sm font-medium text-slate-700">Quantity in stock</label>
<input asp-for="quantity_in_stock" type="number" required step="1" min="0"
       class="block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500" />
<span asp-validation-for="quantity_in_stock" class="mt-1 block text-xs text-rose-600"></span>
</div>
<div class="sm:col-span-3">
<label asp-for="reorder_level" class="mb-1.5 block text-sm font-medium text-slate-700">Reorder level</label>
<input asp-for="reorder_level" type="number" required step="1" min="0"
       class="block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500" />
<span asp-validation-for="reorder_level" class="mt-1 block text-xs text-rose-600"></span>
</div>
        </div>

        <div class="flex items-center gap-3 border-t border-slate-100 pt-5">
            <button type="submit" class="rounded-lg bg-teal-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-teal-700">Save changes</button>
            <a href="/products" class="rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
