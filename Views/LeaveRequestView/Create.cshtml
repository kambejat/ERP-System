@model Erp.Models.LeaveRequest
@{
    ViewData["Title"] = "Add leave request";
    ViewData["Section"] = "Human resources";
    ViewData["ActiveNav"] = "LeaveRequests";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="mb-6">
    <a href="/leave-requests" class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-slate-700">
    @await Html.PartialAsync("_Icon", "back|h-4 w-4")
    Leave requests
</a>
    <h2 class="mt-2 text-lg font-semibold text-slate-900">Add leave request</h2>
    <p class="mt-1 text-sm text-slate-500">Submit or adjust a time-off request.</p>
</div>

<div class="max-w-4xl rounded-xl border border-slate-200 bg-white p-6">
    <form method="post" action="/leave-requests/create" class="space-y-6">
        @Html.AntiForgeryToken()
        <div class="grid grid-cols-1 gap-x-6 gap-y-5 sm:grid-cols-6">
<div class="sm:col-span-6">
<label class="mb-1.5 block text-sm font-medium text-slate-700">Employee</label>
<select asp-for="employee_id" required class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500">
    <option value="" disabled selected>Select employee</option>
    @foreach (var emp in (List<Erp.Models.Employee>)ViewBag.Employees)
    {
        <option value="@emp.employee_id">@emp.first_name @emp.last_name</option>
    }
</select>
<span asp-validation-for="employee_id" class="mt-1 block text-xs text-rose-600"></span>
</div>
<div class="sm:col-span-3">
<label asp-for="leave_type" class="mb-1.5 block text-sm font-medium text-slate-700">Leave type</label>
<select asp-for="leave_type" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500">
    <option value="" disabled selected>Select leave type</option>
    <option value="Annual">Annual</option>
    <option value="Sick">Sick</option>
    <option value="Unpaid">Unpaid</option>
    <option value="Maternity">Maternity</option>
    <option value="Paternity">Paternity</option>
    <option value="Other">Other</option>
</select>
<span asp-validation-for="leave_type" class="mt-1 block text-xs text-rose-600"></span>
</div>
<div class="sm:col-span-3">
<label asp-for="start_date" class="mb-1.5 block text-sm font-medium text-slate-700">Start date</label>
<input asp-for="start_date" type="date" required
       class="block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500" />
<span asp-validation-for="start_date" class="mt-1 block text-xs text-rose-600"></span>
</div>
<div class="sm:col-span-3">
<label asp-for="end_date" class="mb-1.5 block text-sm font-medium text-slate-700">End date</label>
<input asp-for="end_date" type="date" required
       class="block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500" />
<span asp-validation-for="end_date" class="mt-1 block text-xs text-rose-600"></span>
</div>
<div class="sm:col-span-3">
<label asp-for="status" class="mb-1.5 block text-sm font-medium text-slate-700">Status</label>
<select asp-for="status" required class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500">
    <option value="" disabled selected>Select status</option>
    <option value="Pending">Pending</option>
    <option value="Approved">Approved</option>
    <option value="Rejected">Rejected</option>
</select>
<span asp-validation-for="status" class="mt-1 block text-xs text-rose-600"></span>
</div>
        </div>

        <div class="flex items-center gap-3 border-t border-slate-100 pt-5">
            <button type="submit" class="rounded-lg bg-teal-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-teal-700">Create leave request</button>
            <a href="/leave-requests" class="rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
