<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · ERP Console</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@@400;500;600&family=IBM+Plex+Sans:wght@@400;500;600;700&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"IBM Plex Sans"', 'ui-sans-serif', 'system-ui', 'sans-serif'],
                        mono: ['"IBM Plex Mono"', 'ui-monospace', 'SFMono-Regular', 'monospace'],
                    },
                }
            }
        }
    </script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.5.2/flowbite.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="h-full bg-slate-950 font-sans text-slate-800 antialiased">
    <div class="relative flex min-h-full flex-col items-center justify-center overflow-hidden px-4 py-12">
        <div class="pointer-events-none absolute inset-0">
            <div class="absolute -top-32 left-1/2 h-72 w-[36rem] -translate-x-1/2 rounded-full bg-teal-500/20 blur-3xl"></div>
            <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.04)_1px,transparent_1px)] bg-[size:32px_32px]"></div>
        </div>

        <div class="relative mb-8 flex items-center gap-2.5">
            <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-teal-500/15 text-teal-400">
                @await Html.PartialAsync("_Icon", "layers|h-5 w-5")
            </span>
            <span class="text-lg font-semibold tracking-tight text-white">ERP Console</span>
        </div>

        <div class="relative w-full max-w-md rounded-2xl border border-slate-800 bg-white p-8 shadow-2xl shadow-black/40">
            @RenderBody()
        </div>

        <p class="relative mt-8 text-center text-xs text-slate-500">For internal use only.</p>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.5.2/flowbite.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
