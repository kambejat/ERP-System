@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="text-center">
    <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-rose-50 text-rose-500">
        @await Html.PartialAsync("_Icon", "alert-triangle|h-6 w-6")
    </span>
    <h1 class="mt-4 text-lg font-semibold text-slate-900">Something went wrong</h1>
    <p class="mt-1.5 text-sm text-slate-500">
        We hit an unexpected error while processing that request. Try again, and let an administrator know if it keeps happening.
    </p>

    @if (Model != null && Model.ShowRequestId)
    {
        <p class="mt-4 rounded-lg bg-slate-50 px-3 py-2 font-mono text-xs text-slate-500">
            Request ID: <span class="text-slate-700">@Model.RequestId</span>
        </p>
    }

    <a href="/dashboard" class="mt-6 inline-flex items-center gap-2 rounded-lg bg-teal-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-teal-700">
        @await Html.PartialAsync("_Icon", "back|h-4 w-4")
        Back to dashboard
    </a>
</div>
