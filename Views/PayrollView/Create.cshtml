@model Erp.Models.Payroll
@{
    ViewData["Title"] = "Add payroll record";
    ViewData["Section"] = "Human resources";
    ViewData["ActiveNav"] = "Payroll";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="mb-6">
    <a href="/payroll" class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-slate-700">
    @await Html.PartialAsync("_Icon", "back|h-4 w-4")
    Payroll
</a>
    <h2 class="mt-2 text-lg font-semibold text-slate-900">Add payroll record</h2>
    <p class="mt-1 text-sm text-slate-500">Record a pay run for one employee.</p>
</div>

<div class="max-w-4xl rounded-xl border border-slate-200 bg-white p-6">
    <form method="post" action="/payroll/create" class="space-y-6">
        @Html.AntiForgeryToken()
        <div class="grid grid-cols-1 gap-x-6 gap-y-5 sm:grid-cols-6">
<div class="sm:col-span-6">
<label class="mb-1.5 block text-sm font-medium text-slate-700">Employee</label>
<select asp-for="employee_id" required class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500">
    <option value="" disabled selected>Select employee</option>
    @foreach (var emp in (List<Erp.Models.Employee>)ViewBag.Employees)
    {
        <option value="@emp.employee_id">@emp.first_name @emp.last_name</option>
    }
</select>
<span asp-validation-for="employee_id" class="mt-1 block text-xs text-rose-600"></span>
</div>
<div class="sm:col-span-3">
<label asp-for="pay_period_start" class="mb-1.5 block text-sm font-medium text-slate-700">Period start</label>
<input asp-for="pay_period_start" type="date" required
       class="block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500" />
<span asp-validation-for="pay_period_start" class="mt-1 block text-xs text-rose-600"></span>
</div>
<div class="sm:col-span-3">
<label asp-for="pay_period_end" class="mb-1.5 block text-sm font-medium text-slate-700">Period end</label>
<input asp-for="pay_period_end" type="date" required
       class="block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500" />
<span asp-validation-for="pay_period_end" class="mt-1 block text-xs text-rose-600"></span>
</div>
<div class="sm:col-span-3">
<label asp-for="gross_salary" class="mb-1.5 block text-sm font-medium text-slate-700">Gross salary</label>
<input asp-for="gross_salary" type="number" required step="0.01" min="0"
       class="block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500" />
<span asp-validation-for="gross_salary" class="mt-1 block text-xs text-rose-600"></span>
</div>
<div class="sm:col-span-3">
<label asp-for="tax" class="mb-1.5 block text-sm font-medium text-slate-700">Tax</label>
<input asp-for="tax" type="number" required step="0.01" min="0"
       class="block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500" />
<span asp-validation-for="tax" class="mt-1 block text-xs text-rose-600"></span>
</div>
<div class="sm:col-span-3">
<label asp-for="status" class="mb-1.5 block text-sm font-medium text-slate-700">Status</label>
<select asp-for="status" required class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500">
    <option value="" disabled selected>Select status</option>
    <option value="Pending">Pending</option>
    <option value="Processed">Processed</option>
    <option value="Paid">Paid</option>
</select>
<span asp-validation-for="status" class="mt-1 block text-xs text-rose-600"></span>
</div>
<div class="sm:col-span-3">
<label asp-for="processed_at" class="mb-1.5 block text-sm font-medium text-slate-700">Processed at</label>
<input asp-for="processed_at" type="datetime-local" required
       class="block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500" />
<span asp-validation-for="processed_at" class="mt-1 block text-xs text-rose-600"></span>
</div>
        </div>

        <div class="flex items-center gap-3 border-t border-slate-100 pt-5">
            <button type="submit" class="rounded-lg bg-teal-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-teal-700">Create payroll record</button>
            <a href="/payroll" class="rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
