@model Erp.Models.Payroll
@{
    ViewData["Title"] = "Payroll record details";
    ViewData["Section"] = "Human resources";
    ViewData["ActiveNav"] = "Payroll";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <div>
        <a href="/payroll" class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-slate-700">
    @await Html.PartialAsync("_Icon", "back|h-4 w-4")
    Payroll
</a>
        <h2 class="mt-2 text-lg font-semibold text-slate-900">@(Model.Employee != null ? Model.Employee.first_name + " " + Model.Employee.last_name : "Employee #" + Model.employee_id)</h2>
    </div>
    <div class="flex items-center gap-2">
        <a href="/payroll/edit/@Model.payroll_id" class="inline-flex items-center gap-2 rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50">
            @await Html.PartialAsync("_Icon", "pencil|h-4 w-4") Edit
        </a>
        <a href="/payroll/delete/@Model.payroll_id" class="inline-flex items-center gap-2 rounded-lg border border-rose-200 px-4 py-2.5 text-sm font-medium text-rose-600 hover:bg-rose-50">
            @await Html.PartialAsync("_Icon", "trash|h-4 w-4") Delete
        </a>
    </div>
</div>

<div class="max-w-2xl overflow-hidden rounded-xl border border-slate-200 bg-white">
    <div class="flex items-center gap-4 border-b border-slate-100 bg-slate-50/60 px-6 py-5">
        <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-teal-50 text-teal-600">
            @await Html.PartialAsync("_Icon", "banknote|h-5 w-5")
        </span>
        <p class="text-base font-semibold text-slate-900">@(Model.Employee != null ? Model.Employee.first_name + " " + Model.Employee.last_name : "Employee #" + Model.employee_id)</p>
    </div>
    <dl class="divide-y divide-slate-100">
        <div class="grid grid-cols-3 gap-4 px-6 py-4">
            <dt class="text-sm text-slate-500">Employee</dt>
            <dd class="col-span-2 text-sm text-slate-700">@(Model.Employee != null ? Model.Employee.first_name + " " + Model.Employee.last_name : "Employee #" + Model.employee_id)</dd>
        </div>
        <div class="grid grid-cols-3 gap-4 px-6 py-4">
            <dt class="text-sm text-slate-500">Pay period</dt>
            <dd class="col-span-2 text-sm text-slate-700">@Model.pay_period_start.ToString("MMM d, yyyy") - @Model.pay_period_end.ToString("MMM d, yyyy")</dd>
        </div>
        <div class="grid grid-cols-3 gap-4 px-6 py-4">
            <dt class="text-sm text-slate-500">Gross salary</dt>
            <dd class="col-span-2 text-sm text-slate-700">@("$" + (Model.gross_salary).ToString("N2"))</dd>
        </div>
        <div class="grid grid-cols-3 gap-4 px-6 py-4">
            <dt class="text-sm text-slate-500">Tax</dt>
            <dd class="col-span-2 text-sm text-slate-700">@("$" + (Model.tax).ToString("N2"))</dd>
        </div>
        <div class="grid grid-cols-3 gap-4 px-6 py-4">
            <dt class="text-sm text-slate-500">Net pay</dt>
            <dd class="col-span-2 text-sm text-slate-700">@("$" + (Model.gross_salary - Model.tax).ToString("N2"))</dd>
        </div>
        <div class="grid grid-cols-3 gap-4 px-6 py-4">
            <dt class="text-sm text-slate-500">Status</dt>
            <dd class="col-span-2 text-sm text-slate-700">@await Html.PartialAsync("_StatusBadge", Model.status)</dd>
        </div>
        <div class="grid grid-cols-3 gap-4 px-6 py-4">
            <dt class="text-sm text-slate-500">Processed at</dt>
            <dd class="col-span-2 text-sm text-slate-700">@Model.processed_at.ToString("MMM d, yyyy 'at' h:mm tt")</dd>
        </div>
    </dl>
</div>
