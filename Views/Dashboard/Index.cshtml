@using System.Security.Claims
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Section"] = "Overview";
    ViewData["ActiveNav"] = "Dashboard";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";

    var name = User?.Identity?.IsAuthenticated == true ? User.Identity.Name : null;

    var stats = new (string Label, string Value, string Icon, string Accent, string Url)[]
    {
        ("Employees", (ViewBag.EmployeeCount ?? 0).ToString(), "briefcase", "text-teal-600 bg-teal-50", "/employees"),
        ("Pending leave", (ViewBag.PendingLeaveCount ?? 0).ToString(), "calendar", "text-amber-600 bg-amber-50", "/leave-requests"),
        ("Open orders", (ViewBag.OpenOrdersCount ?? 0).ToString(), "cart", "text-sky-600 bg-sky-50", "/orders"),
        ("Low stock items", (ViewBag.LowStockCount ?? 0).ToString(), "cube", "text-rose-600 bg-rose-50", "/products"),
        ("Suppliers", (ViewBag.SupplierCount ?? 0).ToString(), "truck", "text-indigo-600 bg-indigo-50", "/suppliers"),
        ("Revenue this month", "$" + string.Format("{0:N0}", (decimal)(ViewBag.MonthRevenue ?? 0m)), "trending-up", "text-emerald-600 bg-emerald-50", "/transactions"),
    };

    var modules = new (string Label, string Desc, string Icon, string Url)[]
    {
        ("Employees", "Directory, roles, and status", "briefcase", "/employees"),
        ("Attendance", "Daily check-in and check-out log", "clock", "/attendance"),
        ("Leave requests", "Review and approve time off", "calendar", "/leave-requests"),
        ("Payroll", "Pay periods and processed runs", "banknote", "/payroll"),
        ("Orders", "Customer orders and line items", "cart", "/orders"),
        ("Products", "Catalog, pricing, and stock", "cube", "/products"),
        ("Transactions", "Payments linked to orders", "card", "/transactions"),
        ("Suppliers", "Vendor contacts and status", "truck", "/suppliers"),
        ("Users", "Accounts and access roles", "users", "/users"),
        ("Settings", "System key/value configuration", "cog", "/settings"),
    };

    var recentLogs = ViewBag.RecentLogs as IEnumerable<Erp.Models.Log>;
}

<div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div>
        <h2 class="text-lg font-semibold text-slate-900">Welcome back@(string.IsNullOrEmpty(name) ? "" : $", {name}")</h2>
        <p class="mt-1 text-sm text-slate-500">Here's what's happening across the business today.</p>
    </div>
    <a href="/orders/create" class="inline-flex items-center gap-2 rounded-lg bg-teal-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-teal-700">
        @await Html.PartialAsync("_Icon", "plus|h-4 w-4")
        New order
    </a>
</div>

<div class="grid grid-cols-2 gap-4 lg:grid-cols-3 xl:grid-cols-6">
    @foreach (var s in stats)
    {
        <a href="@s.Url" class="rounded-xl border border-slate-200 bg-white p-4 transition-shadow hover:shadow-md">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg @s.Accent">
                @await Html.PartialAsync("_Icon", s.Icon + "|h-[18px] w-[18px]")
            </span>
            <p class="mt-3 font-mono text-2xl font-semibold text-slate-900">@s.Value</p>
            <p class="mt-0.5 text-xs text-slate-500">@s.Label</p>
        </a>
    }
</div>

<div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-3">
    <div class="lg:col-span-2">
        <h3 class="text-sm font-semibold text-slate-900">Modules</h3>
        <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
            @foreach (var m in modules)
            {
                <a href="@m.Url" class="group flex items-start gap-3 rounded-xl border border-slate-200 bg-white p-4 hover:border-teal-200 hover:bg-teal-50/40">
                    <span class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-500 group-hover:bg-teal-100 group-hover:text-teal-700">
                        @await Html.PartialAsync("_Icon", m.Icon + "|h-[18px] w-[18px]")
                    </span>
                    <span class="min-w-0">
                        <span class="block text-sm font-medium text-slate-800">@m.Label</span>
                        <span class="mt-0.5 block truncate text-xs text-slate-500">@m.Desc</span>
                    </span>
                </a>
            }
        </div>
    </div>

    <div>
        <h3 class="text-sm font-semibold text-slate-900">Recent activity</h3>
        <div class="mt-3 rounded-xl border border-slate-200 bg-white">
            @if (recentLogs != null && recentLogs.Any())
            {
                <ul class="divide-y divide-slate-100">
                    @foreach (var log in recentLogs)
                    {
                        <li class="flex items-start gap-3 px-4 py-3">
                            <span class="mt-0.5 flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-500">
                                @await Html.PartialAsync("_Icon", "clipboard|h-3.5 w-3.5")
                            </span>
                            <span class="min-w-0">
                                <span class="block text-sm text-slate-700">@log.action</span>
                                <span class="mt-0.5 block text-xs text-slate-400">
                                    @(log.User != null ? log.User.username : "user #" + log.user_id) · @log.timestamp.ToString("MMM d, h:mm tt")
                                </span>
                            </span>
                        </li>
                    }
                </ul>
                <a href="/logs" class="flex items-center justify-center gap-1.5 border-t border-slate-100 py-2.5 text-xs font-medium text-teal-600 hover:text-teal-700">
                    View all activity
                    @await Html.PartialAsync("_Icon", "arrow-right|h-3.5 w-3.5")
                </a>
            }
            else
            {
                <div class="px-4 py-8 text-center">
                    <span class="mx-auto flex h-9 w-9 items-center justify-center rounded-full bg-slate-100 text-slate-400">
                        @await Html.PartialAsync("_Icon", "inbox|h-4 w-4")
                    </span>
                    <p class="mt-2 text-xs text-slate-400">No activity recorded yet.</p>
                </div>
            }
        </div>
    </div>
</div>
