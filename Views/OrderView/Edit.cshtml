@model Erp.Models.Order
@{
    ViewData["Title"] = "Edit order";
    ViewData["Section"] = "Operations";
    ViewData["ActiveNav"] = "Orders";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
    var users = (List<Erp.Models.User>)ViewBag.Users;
}

<div class="mb-6">
    <a href="/orders" class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-slate-700">
        @await Html.PartialAsync("_Icon", "back|h-4 w-4")
        Orders
    </a>
    <h2 class="mt-2 text-lg font-semibold text-slate-900">Edit order #@Model.order_id</h2>
</div>

<div class="max-w-4xl rounded-xl border border-slate-200 bg-white p-6">
    <form method="post" action="/orders/edit/@Model.order_id" id="order-form" class="space-y-6">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="order_id" />

        <div class="grid grid-cols-1 gap-x-6 gap-y-5 sm:grid-cols-6">
            <div class="sm:col-span-3">
                <label class="mb-1.5 block text-sm font-medium text-slate-700">Customer</label>
                <select asp-for="user_id" required class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500">
                    @foreach (var u in users)
                    {
                        <option value="@u.user_id" selected="@(Model.user_id == u.user_id)">@u.username</option>
                    }
                </select>
                <span asp-validation-for="user_id" class="mt-1 block text-xs text-rose-600"></span>
            </div>
            <div class="sm:col-span-3">
                <label asp-for="order_date" class="mb-1.5 block text-sm font-medium text-slate-700">Order date</label>
                <input asp-for="order_date" type="date" required
                       class="block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500" />
                <span asp-validation-for="order_date" class="mt-1 block text-xs text-rose-600"></span>
            </div>
            <div class="sm:col-span-3">
                <label class="mb-1.5 block text-sm font-medium text-slate-700">Status</label>
                <select asp-for="status" class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500">
                    @foreach (var st in Enum.GetValues<OrderStatus>())
                    {
                        <option value="@st" selected="@(Model.status == st)">@st</option>
                    }
                </select>
            </div>
        </div>

        @await Html.PartialAsync("_OrderItemsEditor", Model)

        <div class="flex items-center gap-3 border-t border-slate-100 pt-5">
            <button type="submit" class="rounded-lg bg-teal-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-teal-700">Save changes</button>
            <a href="/orders" class="rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
