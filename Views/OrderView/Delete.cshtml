@model Erp.Models.Order
@{
    ViewData["Title"] = "Delete order";
    ViewData["Section"] = "Operations";
    ViewData["ActiveNav"] = "Orders";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="mb-6">
    <a href="/orders" class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-slate-700">
        @await Html.PartialAsync("_Icon", "back|h-4 w-4")
        Orders
    </a>
</div>

<div class="max-w-lg rounded-xl border border-rose-200 bg-white p-6">
    <span class="flex h-11 w-11 items-center justify-center rounded-full bg-rose-50 text-rose-500">
        @await Html.PartialAsync("_Icon", "trash|h-5 w-5")
    </span>
    <h2 class="mt-4 text-base font-semibold text-slate-900">Delete order #@Model.order_id?</h2>
    <p class="mt-1.5 text-sm text-slate-500">
        This removes the order and all @(Model.order_items != null ? Model.order_items.Count : 0) line item(s) on it, along with any linked transactions you haven't already removed. This can't be undone.
    </p>

    <form method="post" action="/orders/delete/@Model.order_id" class="mt-6 flex items-center gap-3">
        @Html.AntiForgeryToken()
        <button type="submit" class="rounded-lg bg-rose-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-rose-700">Delete order</button>
        <a href="/orders" class="rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50">Cancel</a>
    </form>
</div>
