@model IEnumerable<Erp.Models.Order>
@{
    ViewData["Title"] = "Orders";
    ViewData["Section"] = "Operations";
    ViewData["ActiveNav"] = "Orders";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
    var userNames = (Dictionary<int, string>)ViewBag.UserNames;
}

<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <div>
        <h2 class="text-lg font-semibold text-slate-900">Orders</h2>
        <p class="mt-1 text-sm text-slate-500">Customer orders and their line items.</p>
    </div>
    <a href="/orders/create" class="inline-flex items-center gap-2 rounded-lg bg-teal-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-teal-700">
        @await Html.PartialAsync("_Icon", "plus|h-4 w-4")
        New order
    </a>
</div>

<div class="rounded-xl border border-slate-200 bg-white">
    <div class="border-b border-slate-200 p-4">
        <div class="relative max-w-xs">
            <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                @await Html.PartialAsync("_Icon", "search|h-4 w-4")
            </span>
            <input type="text" data-table-search="#orders-table" placeholder="Search orders"
                   class="block w-full rounded-lg border border-slate-300 py-2 pl-9 pr-3 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500" />
        </div>
    </div>

    <div class="overflow-x-auto">
        <table id="orders-table" class="w-full text-left text-sm">
            <thead>
                <tr class="border-b border-slate-200 text-xs font-medium text-slate-500">
                    <th class="px-4 py-3">Order</th>
                    <th class="px-4 py-3">Customer</th>
                    <th class="px-4 py-3">Date</th>
                    <th class="px-4 py-3">Items</th>
                    <th class="px-4 py-3">Status</th>
                    <th class="px-4 py-3">Total</th>
                    <th class="px-4 py-3 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr class="hover:bg-slate-50">
                            <td class="px-4 py-3 font-mono text-slate-500">#@item.order_id</td>
                            <td class="px-4 py-3 font-medium text-slate-800">@(userNames.GetValueOrDefault(item.user_id, "User #" + item.user_id))</td>
                            <td class="px-4 py-3">@item.order_date.ToString("MMM d, yyyy")</td>
                            <td class="px-4 py-3 text-slate-500">@(item.order_items != null ? item.order_items.Count : 0)</td>
                            <td class="px-4 py-3">
                                @await Html.PartialAsync("_StatusBadge", item.status.ToString())
                            </td>
                            <td class="px-4 py-3 font-mono">@("$" + item.total_amount.ToString("N2"))</td>
                            <td class="px-4 py-3">
                                <div class="flex items-center justify-end gap-1">
                                    <a href="/orders/details/@item.order_id" title="View" class="rounded-lg p-2 text-slate-400 hover:bg-slate-100 hover:text-slate-700">@await Html.PartialAsync("_Icon", "eye|h-4 w-4")</a>
                                    <a href="/orders/edit/@item.order_id" title="Edit" class="rounded-lg p-2 text-slate-400 hover:bg-slate-100 hover:text-slate-700">@await Html.PartialAsync("_Icon", "pencil|h-4 w-4")</a>
                                    <a href="/orders/delete/@item.order_id" title="Delete" class="rounded-lg p-2 text-slate-400 hover:bg-rose-50 hover:text-rose-600">@await Html.PartialAsync("_Icon", "trash|h-4 w-4")</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                <tr data-empty-row class="hidden">
                    <td colspan="7" class="px-4 py-10 text-center text-sm text-slate-400">No orders match your search.</td>
                </tr>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="7" class="px-4 py-10 text-center text-sm text-slate-400">
                            No orders yet. <a href="/orders/create" class="font-medium text-teal-600 hover:text-teal-700">Create the first one</a>.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
