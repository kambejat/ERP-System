@model Erp.Models.Log
@{
    ViewData["Title"] = "Log entry details";
    ViewData["Section"] = "Administration";
    ViewData["ActiveNav"] = "Logs";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <div>
        <a href="/logs" class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-slate-700">
    @await Html.PartialAsync("_Icon", "back|h-4 w-4")
    Activity logs
</a>
        <h2 class="mt-2 text-lg font-semibold text-slate-900">@Model.action</h2>
    </div>
    <div class="flex items-center gap-2">
        <a href="/logs/delete/@Model.log_id" class="inline-flex items-center gap-2 rounded-lg border border-rose-200 px-4 py-2.5 text-sm font-medium text-rose-600 hover:bg-rose-50">
            @await Html.PartialAsync("_Icon", "trash|h-4 w-4") Delete
        </a>
    </div>
</div>

<div class="max-w-2xl overflow-hidden rounded-xl border border-slate-200 bg-white">
    <div class="flex items-center gap-4 border-b border-slate-100 bg-slate-50/60 px-6 py-5">
        <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-teal-50 text-teal-600">
            @await Html.PartialAsync("_Icon", "clipboard|h-5 w-5")
        </span>
        <p class="text-base font-semibold text-slate-900">@Model.action</p>
    </div>
    <dl class="divide-y divide-slate-100">
        <div class="grid grid-cols-3 gap-4 px-6 py-4">
            <dt class="text-sm text-slate-500">User</dt>
            <dd class="col-span-2 text-sm text-slate-700">@(Model.User != null ? Model.User.username : "User #" + Model.user_id)</dd>
        </div>
        <div class="grid grid-cols-3 gap-4 px-6 py-4">
            <dt class="text-sm text-slate-500">Action</dt>
            <dd class="col-span-2 text-sm text-slate-700">@Model.action</dd>
        </div>
        <div class="grid grid-cols-3 gap-4 px-6 py-4">
            <dt class="text-sm text-slate-500">Timestamp</dt>
            <dd class="col-span-2 text-sm text-slate-700">@Model.timestamp.ToString("MMM d, yyyy 'at' h:mm tt")</dd>
        </div>
    </dl>
</div>
