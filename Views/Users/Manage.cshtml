@model IEnumerable<Erp.Models.User>

@{
    ViewData["Title"] = "Manage Users";
}

<h1>@ViewData["Title"]</h1>

<form class="mb-4" method="get" action="@Url.Action("Manage", "Users")">
    <div class="input-group">
        <input type="text" class="form-control" name="search" placeholder="Search by username or role" />
        <button class="btn btn-primary" type="submit">Search</button>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Username</th>
            <th>Role</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.username</td>
                <td>@user.role</td>
                <td>
                    <a href="@Url.Action("Details", "Users", new { id = user.user_id })" class="btn btn-info btn-sm">Details</a>
                    <a href="@Url.Action("Edit", "Users", new { id = user.user_id })" class="btn btn-warning btn-sm">Edit</a>
                    <a href="@Url.Action("Delete", "Users", new { id = user.user_id })" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this user?')">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a href="@Url.Action("Create", "Users")" class="btn btn-primary mt-3">Add New User</a>
