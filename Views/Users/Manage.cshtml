@model IEnumerable<Erp.Models.User>
@{
    ViewData["Title"] = "Users";
    ViewData["Section"] = "Administration";
    ViewData["ActiveNav"] = "Users";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <div>
        <h2 class="text-lg font-semibold text-slate-900">Users</h2>
        <p class="mt-1 text-sm text-slate-500">Accounts that can sign in to this console.</p>
    </div>
    <a href="@Url.Action("Create", "Users")" class="inline-flex items-center gap-2 rounded-lg bg-teal-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-teal-700">
        @await Html.PartialAsync("_Icon", "plus|h-4 w-4")
        Add user
    </a>
</div>

<div class="rounded-xl border border-slate-200 bg-white">
    <div class="border-b border-slate-200 p-4">
        <form method="get" asp-controller="Users" asp-action="Manage" class="relative max-w-xs">
            <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                @await Html.PartialAsync("_Icon", "search|h-4 w-4")
            </span>
            <input type="text" name="search" data-table-search="#users-table" placeholder="Search by username or role"
                   class="block w-full rounded-lg border border-slate-300 py-2 pl-9 pr-3 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500" />
        </form>
    </div>

    <div class="overflow-x-auto">
        <table id="users-table" class="w-full text-left text-sm">
            <thead>
                <tr class="border-b border-slate-200 text-xs font-medium text-slate-500">
                    <th class="px-4 py-3">User</th>
                    <th class="px-4 py-3">Email</th>
                    <th class="px-4 py-3">Role</th>
                    <th class="px-4 py-3">Status</th>
                    <th class="px-4 py-3 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @if (Model != null && Model.Any())
                {
                    foreach (var user in Model)
                    {
                        <tr class="hover:bg-slate-50">
                            <td class="px-4 py-3">
                                <div class="flex items-center gap-3">
                                    <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-slate-100 text-xs font-semibold text-slate-600">
                                        @(user.username.Length > 0 ? user.username.Substring(0, 1).ToUpper() : "?")
                                    </span>
                                    <span class="font-medium text-slate-800">@user.username</span>
                                </div>
                            </td>
                            <td class="px-4 py-3 text-slate-500">@user.email</td>
                            <td class="px-4 py-3">@await Html.PartialAsync("_StatusBadge", user.role)</td>
                            <td class="px-4 py-3">@await Html.PartialAsync("_StatusBadge", user.isActive ? "Active" : "Inactive")</td>
                            <td class="px-4 py-3">
                                <div class="flex items-center justify-end gap-1">
                                    <a href="@Url.Action("Details", "Users", new { id = user.user_id })" title="View" class="rounded-lg p-2 text-slate-400 hover:bg-slate-100 hover:text-slate-700">
                                        @await Html.PartialAsync("_Icon", "eye|h-4 w-4")
                                    </a>
                                    <a href="@Url.Action("Edit", "Users", new { id = user.user_id })" title="Edit" class="rounded-lg p-2 text-slate-400 hover:bg-slate-100 hover:text-slate-700">
                                        @await Html.PartialAsync("_Icon", "pencil|h-4 w-4")
                                    </a>
                                    <a href="@Url.Action("Delete", "Users", new { id = user.user_id })" title="Delete" class="rounded-lg p-2 text-slate-400 hover:bg-rose-50 hover:text-rose-600">
                                        @await Html.PartialAsync("_Icon", "trash|h-4 w-4")
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                <tr data-empty-row class="hidden">
                    <td colspan="5" class="px-4 py-10 text-center text-sm text-slate-400">No users match your search.</td>
                </tr>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="5" class="px-4 py-10 text-center text-sm text-slate-400">
                            No users yet. <a href="@Url.Action("Create", "Users")" class="font-medium text-teal-600 hover:text-teal-700">Add the first one</a>.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
