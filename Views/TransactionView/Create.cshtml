@model Erp.Models.Transaction
@{
    ViewData["Title"] = "Add transaction";
    ViewData["Section"] = "Operations";
    ViewData["ActiveNav"] = "Transactions";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="mb-6">
    <a href="/transactions" class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-slate-700">
    @await Html.PartialAsync("_Icon", "back|h-4 w-4")
    Transactions
</a>
    <h2 class="mt-2 text-lg font-semibold text-slate-900">Add transaction</h2>
    <p class="mt-1 text-sm text-slate-500">Record a payment against an existing order.</p>
</div>

<div class="max-w-4xl rounded-xl border border-slate-200 bg-white p-6">
    <form method="post" action="/transactions/create" class="space-y-6">
        @Html.AntiForgeryToken()
        <div class="grid grid-cols-1 gap-x-6 gap-y-5 sm:grid-cols-6">
<div class="sm:col-span-6">
<label class="mb-1.5 block text-sm font-medium text-slate-700">Order</label>
<select asp-for="order_id" required class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500">
    <option value="" disabled selected>Select order</option>
    @foreach (var o in (List<Erp.Models.Order>)ViewBag.Orders)
    {
        <option value="@o.order_id">Order #@o.order_id — @o.order_date.ToString("MMM d, yyyy")</option>
    }
</select>
<span asp-validation-for="order_id" class="mt-1 block text-xs text-rose-600"></span>
</div>
<div class="sm:col-span-3">
<label asp-for="transaction_date" class="mb-1.5 block text-sm font-medium text-slate-700">Transaction date</label>
<input asp-for="transaction_date" type="date" required
       class="block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500" />
<span asp-validation-for="transaction_date" class="mt-1 block text-xs text-rose-600"></span>
</div>
<div class="sm:col-span-3">
<label asp-for="amount" class="mb-1.5 block text-sm font-medium text-slate-700">Amount</label>
<input asp-for="amount" type="number" required step="0.01" min="0"
       class="block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500" />
<span asp-validation-for="amount" class="mt-1 block text-xs text-rose-600"></span>
</div>
<div class="sm:col-span-3">
<label asp-for="payment_method" class="mb-1.5 block text-sm font-medium text-slate-700">Payment method</label>
<select asp-for="payment_method" required class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500">
    <option value="" disabled selected>Select payment method</option>
    @foreach (var pm in Enum.GetValues<PaymentMethod>())
    {
        <option value="@pm">@pm.ToString().Replace("_", " ")</option>
    }
</select>
<span asp-validation-for="payment_method" class="mt-1 block text-xs text-rose-600"></span>
</div>
<div class="sm:col-span-3">
<label asp-for="status" class="mb-1.5 block text-sm font-medium text-slate-700">Status</label>
<select asp-for="status" required class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500">
    <option value="" disabled selected>Select status</option>
    @foreach (var st in Enum.GetValues<TransactionStatus>())
    {
        <option value="@st">@st</option>
    }
</select>
<span asp-validation-for="status" class="mt-1 block text-xs text-rose-600"></span>
</div>
        </div>

        <div class="flex items-center gap-3 border-t border-slate-100 pt-5">
            <button type="submit" class="rounded-lg bg-teal-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-teal-700">Create transaction</button>
            <a href="/transactions" class="rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
