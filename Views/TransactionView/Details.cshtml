@model Erp.Models.Transaction
@{
    ViewData["Title"] = "Transaction details";
    ViewData["Section"] = "Operations";
    ViewData["ActiveNav"] = "Transactions";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <div>
        <a href="/transactions" class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-slate-700">
    @await Html.PartialAsync("_Icon", "back|h-4 w-4")
    Transactions
</a>
        <h2 class="mt-2 text-lg font-semibold text-slate-900">Transaction #@Model.transaction_id</h2>
    </div>
    <div class="flex items-center gap-2">
        <a href="/transactions/edit/@Model.transaction_id" class="inline-flex items-center gap-2 rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50">
            @await Html.PartialAsync("_Icon", "pencil|h-4 w-4") Edit
        </a>
        <a href="/transactions/delete/@Model.transaction_id" class="inline-flex items-center gap-2 rounded-lg border border-rose-200 px-4 py-2.5 text-sm font-medium text-rose-600 hover:bg-rose-50">
            @await Html.PartialAsync("_Icon", "trash|h-4 w-4") Delete
        </a>
    </div>
</div>

<div class="max-w-2xl overflow-hidden rounded-xl border border-slate-200 bg-white">
    <div class="flex items-center gap-4 border-b border-slate-100 bg-slate-50/60 px-6 py-5">
        <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-teal-50 text-teal-600">
            @await Html.PartialAsync("_Icon", "card|h-5 w-5")
        </span>
        <p class="text-base font-semibold text-slate-900">Transaction #@Model.transaction_id</p>
    </div>
    <dl class="divide-y divide-slate-100">
        <div class="grid grid-cols-3 gap-4 px-6 py-4">
            <dt class="text-sm text-slate-500">Order</dt>
            <dd class="col-span-2 text-sm text-slate-700"><a href="/orders/details/@Model.order_id" class="font-medium text-teal-600 hover:text-teal-700">Order #@Model.order_id</a></dd>
        </div>
        <div class="grid grid-cols-3 gap-4 px-6 py-4">
            <dt class="text-sm text-slate-500">Date</dt>
            <dd class="col-span-2 text-sm text-slate-700">@Model.transaction_date.ToString("MMM d, yyyy")</dd>
        </div>
        <div class="grid grid-cols-3 gap-4 px-6 py-4">
            <dt class="text-sm text-slate-500">Amount</dt>
            <dd class="col-span-2 text-sm text-slate-700">@("$" + (Model.amount).ToString("N2"))</dd>
        </div>
        <div class="grid grid-cols-3 gap-4 px-6 py-4">
            <dt class="text-sm text-slate-500">Payment method</dt>
            <dd class="col-span-2 text-sm text-slate-700">@await Html.PartialAsync("_StatusBadge", Model.payment_method.ToString().Replace("_", " "))</dd>
        </div>
        <div class="grid grid-cols-3 gap-4 px-6 py-4">
            <dt class="text-sm text-slate-500">Status</dt>
            <dd class="col-span-2 text-sm text-slate-700">@await Html.PartialAsync("_StatusBadge", Model.status.ToString())</dd>
        </div>
    </dl>
</div>
