@model Erp.Models.Attendance
@{
    ViewData["Title"] = "Edit attendance record";
    ViewData["Section"] = "Human resources";
    ViewData["ActiveNav"] = "Attendance";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<div class="mb-6">
    <a href="/attendance" class="inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-slate-700">
    @await Html.PartialAsync("_Icon", "back|h-4 w-4")
    Attendance
</a>
    <h2 class="mt-2 text-lg font-semibold text-slate-900">Edit Attendance record</h2>
    <p class="mt-1 text-sm text-slate-500">Log or adjust a single day's attendance for one employee.</p>
</div>

<div class="max-w-4xl rounded-xl border border-slate-200 bg-white p-6">
    <form method="post" action="/attendance/edit/@Model.attendance_id" class="space-y-6">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="attendance_id" />
<div class="grid grid-cols-1 gap-x-6 gap-y-5 sm:grid-cols-6">
<div class="sm:col-span-6">
<label class="mb-1.5 block text-sm font-medium text-slate-700">Employee</label>
<select asp-for="employee_id" required class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500">
    @foreach (var emp in (List<Erp.Models.Employee>)ViewBag.Employees)
    {
        <option value="@emp.employee_id" selected="@(Model.employee_id == emp.employee_id)">@emp.first_name @emp.last_name</option>
    }
</select>
<span asp-validation-for="employee_id" class="mt-1 block text-xs text-rose-600"></span>
</div>
<div class="sm:col-span-3">
<label asp-for="date" class="mb-1.5 block text-sm font-medium text-slate-700">Date</label>
<input asp-for="date" type="date" required
       class="block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500" />
<span asp-validation-for="date" class="mt-1 block text-xs text-rose-600"></span>
</div>
<div class="sm:col-span-3">
<label asp-for="check_in" class="mb-1.5 block text-sm font-medium text-slate-700">Check-in</label>
<input asp-for="check_in" type="datetime-local"
       class="block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500" />
<span asp-validation-for="check_in" class="mt-1 block text-xs text-rose-600"></span>
</div>
<div class="sm:col-span-3">
<label asp-for="check_out" class="mb-1.5 block text-sm font-medium text-slate-700">Check-out</label>
<input asp-for="check_out" type="datetime-local"
       class="block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500" />
<span asp-validation-for="check_out" class="mt-1 block text-xs text-rose-600"></span>
</div>
<div class="sm:col-span-3">
<label asp-for="status" class="mb-1.5 block text-sm font-medium text-slate-700">Status</label>
<select asp-for="status" required class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm focus:border-teal-500 focus:outline-none focus:ring-1 focus:ring-teal-500">
    <option value="Present" selected="@(Model.status == "Present")">Present</option>
    <option value="Absent" selected="@(Model.status == "Absent")">Absent</option>
    <option value="Late" selected="@(Model.status == "Late")">Late</option>
    <option value="Half Day" selected="@(Model.status == "Half Day")">Half Day</option>
    <option value="On Leave" selected="@(Model.status == "On Leave")">On Leave</option>
</select>
<span asp-validation-for="status" class="mt-1 block text-xs text-rose-600"></span>
</div>
        </div>

        <div class="flex items-center gap-3 border-t border-slate-100 pt-5">
            <button type="submit" class="rounded-lg bg-teal-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-teal-700">Save changes</button>
            <a href="/attendance" class="rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
